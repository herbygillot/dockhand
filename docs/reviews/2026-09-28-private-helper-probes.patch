+++ b/internal/engine/helper_review_test.go
@@ -0,0 +1,38 @@
+package engine
+
+import (
+	"testing"
+
+	"github.com/herbygillot/dockhand/internal/macports"
+	"github.com/herbygillot/dockhand/internal/model"
+	"github.com/stretchr/testify/require"
+)
+
+func TestHelperReviewEligibilityUsesOptionSemantics(t *testing.T) {
+	t.Run("known_fail on", func(t *testing.T) {
+		info := macports.PortInfo{Options: map[string]string{"known_fail": "on"}}
+		value, err := info.Bool("known_fail")
+		require.NoError(t, err)
+		require.True(t, value)
+		require.Equal(t, "known_fail", ineligible(info, tahoeArm.Platform))
+	})
+	t.Run("Tcl list", func(t *testing.T) {
+		info := macports.PortInfo{Options: map[string]string{"supported_archs": "{arm64}"}}
+		require.Empty(t, ineligible(info, tahoeArm.Platform))
+	})
+}
+
+func TestHelperReviewRevisionProofDistinguishesData(t *testing.T) {
+	f := setup(t)
+	write(t, f.clone, map[string]string{"textproc/jq/Portfile": "name jq\nset contents {\nrevision 1\n}\n"})
+	run(t, f.clone, "add", "-A")
+	run(t, f.clone, "commit", "-qm", "before")
+	before := run(t, f.clone, "rev-parse", "HEAD^{tree}")
+	write(t, f.clone, map[string]string{"textproc/jq/Portfile": "name jq\nset contents {\nrevision 2\n}\n"})
+	run(t, f.clone, "add", "-A")
+	after := run(t, f.clone, "write-tree")
+	e := f.open(t)
+	kind, err := e.targetKind(t.Context(), before, after, "textproc/jq", []string{"textproc/jq/Portfile"})
+	require.NoError(t, err)
+	require.Equal(t, model.Substantive, kind)
+}
diff --git a/internal/archive/helper_review_test.go b/internal/archive/helper_review_test.go
