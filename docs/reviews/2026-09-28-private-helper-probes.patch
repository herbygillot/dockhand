--- /dev/null
+++ b/internal/archive/helper_review_test.go
@@ -0,0 +1,30 @@
+package archive
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestHelperReviewCargoDependencySubtable(t *testing.T) {
+	before := tarball(t, "pkg-1", map[string]string{"Cargo.toml": "[package]\nname = 'pkg'\nversion = '1.0.0'\n"})
+	after := tarball(t, "pkg-2", map[string]string{"Cargo.toml": "[package]\nname = 'pkg'\nversion = '2.0.0'\n[dependencies.serde]\nversion = '1'\n"})
+	changes, err := Compare(t.Context(), before, after)
+	require.NoError(t, err)
+	require.NotEmpty(t, changes, "the added dependency must be visible")
+}
+
+func TestHelperReviewPythonLiteralStrings(t *testing.T) {
+	before := tarball(t, "pkg-1", map[string]string{"pyproject.toml": "[project]\ndependencies = ['click>=8']\n"})
+	after := tarball(t, "pkg-2", map[string]string{"pyproject.toml": "[project]\ndependencies = ['click>=8', 'rich>=13']\n"})
+	changes, err := Compare(t.Context(), before, after)
+	require.NoError(t, err)
+	require.NotEmpty(t, changes, "the added dependency must be visible")
+}
+
+func TestHelperReviewManifestDecodeFailureIsVisible(t *testing.T) {
+	before := tarball(t, "pkg-1", map[string]string{"package.json": `{ "name": "pkg" }`})
+	after := tarball(t, "pkg-2", map[string]string{"package.json": `{ "dependencies":`})
+	_, err := Compare(t.Context(), before, after)
+	require.Error(t, err, "an unreadable manifest is not a successful empty comparison")
+}
