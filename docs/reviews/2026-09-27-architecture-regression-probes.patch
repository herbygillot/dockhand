+package command
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// No network or real fork: githubBranch uses the existing synthetic Git
+// repository and Actions API fixtures.
+func TestArchitectureReviewGitHubHonorsRequiredTests(t *testing.T) {
+	f, _ := githubBranch(t)
+	f.logs = []map[string]string{{"build (macos-14)": built("jq", false), "build (macos-15)": built("jq", true)}}
+	f.conclusion = []string{"success"}
+	out, errs, err := dockhand(t, "check", "--on", "github", "--tests", "required")
+	t.Log(out, errs)
+	require.Error(t, err, "a failing test must fail a check explicitly requiring tests")
+}
