+package sourcecompare
+
+import "testing"
+
+func TestHelperReviewMarkerOnlyChangeIsVisible(t *testing.T) {
+	changes := compared(t,
+		map[string]string{"requirements.txt": "requests>=2; sys_platform == 'win32'\n"},
+		map[string]string{"requirements.txt": "requests>=2; sys_platform == 'darwin'\n"})
+	if len(changes) == 0 {
+		t.Fatal("a requirement became applicable to Darwin, but the comparison has no findings")
+	}
+}
+
+func TestHelperReviewCargoSourceChangeIsVisible(t *testing.T) {
+	changes := compared(t,
+		map[string]string{"Cargo.toml": "[dependencies]\nwidget = { version = '1', git = 'https://example.invalid/widget', rev = 'aaaa' }\n"},
+		map[string]string{"Cargo.toml": "[dependencies]\nwidget = { version = '1', git = 'https://example.invalid/widget', rev = 'bbbb' }\n"})
+	if len(changes) == 0 {
+		t.Fatal("a dependency's source revision moved, but its version string hides the change")
+	}
+}
