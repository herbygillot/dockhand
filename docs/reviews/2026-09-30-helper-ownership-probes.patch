+package macports
+
+import (
+	"testing"
+
+	"github.com/herbygillot/dockhand/internal/tcl/syntax"
+)
+
+func TestHelperReviewVariantReadFailuresAreNotEmpty(t *testing.T) {
+	for _, key := range []string{"variants", "vinfo"} {
+		t.Run(key, func(t *testing.T) {
+			port := PortInfo{Name: "demo", OptionErrors: map[string]string{key: "could not evaluate"}}
+			if variants, err := port.Variants(); err == nil {
+				t.Fatalf("failed %s was read as a successful variant list: %#v", key, variants)
+			}
+		})
+	}
+}
+
+func TestHelperReviewVariantConstraintsKeepParseFailures(t *testing.T) {
+	for _, field := range []string{"requires", "conflicts"} {
+		t.Run(field, func(t *testing.T) {
+			fields := field + " " + syntax.Quote("{")
+			port := PortInfo{Name: "demo", Options: map[string]string{"variants": "tests", "vinfo": "tests " + syntax.Quote(fields)}}
+			if variants, err := port.Variants(); err == nil {
+				t.Fatalf("malformed %s was read without an error: %#v", field, variants)
+			}
+		})
+	}
+}
