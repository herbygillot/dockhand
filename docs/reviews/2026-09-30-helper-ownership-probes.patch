+package engine
+
+import (
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/herbygillot/dockhand/internal/fetch"
+	"github.com/herbygillot/dockhand/internal/macports"
+	"github.com/herbygillot/dockhand/internal/macports/portedit/archives"
+	"github.com/herbygillot/dockhand/internal/model"
+	"github.com/herbygillot/dockhand/internal/preparation"
+	"github.com/herbygillot/dockhand/internal/sourcecompare"
+)
+
+func TestHelperReviewWindowsOnlyPinDoesNotHoldMacOS(t *testing.T) {
+	dir := t.TempDir()
+	old := archives.Download{Name: "old.tar.gz", Path: writeTarball(t, dir, "pkg-1", map[string]string{
+		"requirements.txt": "requests==1; sys_platform == 'win32'\n",
+	})}
+	next := archives.Download{Name: "new.tar.gz", Path: writeTarball(t, dir, "pkg-2", map[string]string{
+		"requirements.txt": "requests==999; sys_platform == 'win32'\n",
+	})}
+	result := preparation.Result{}
+	result.Target = model.Target{Name: "demo"}
+	result.Downloads = []archives.Download{next}
+	result.Pairs = []preparation.ArchivePair{{Previous: old, Next: next}}
+	result.Prepared = macports.Snapshot{
+		Platform: model.Platform{OS: "darwin", Version: "25", Architecture: "arm64"},
+		Ports:    map[string]macports.PortInfo{"demo": {Name: "demo", Options: map[string]string{"dockhand.portgroups": "python"}, Dependencies: []macports.Dependency{{Port: "py313-requests"}}}},
+	}
+	e := Engine{PortReader: fakePorts{directories: map[string][]macports.PortInfo{
+		"python/py-requests": {{Name: "py313-requests", Version: "1"}},
+	}}}
+	_, requirements := compareUpstream(t.Context(), result, sourcecompare.Versions{})
+	for _, change := range e.pythonPins(t.Context(), model.Source{}, result, requirements) {
+		if change.Hold {
+			t.Errorf("a Windows-only requirement held the MacPorts update: %s", change.Message)
+		}
+	}
+}
+
+type helperReviewTransport func(*http.Request) (*http.Response, error)
+
+func (f helperReviewTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestHelperReviewHTTPSProbeRejectsDowngrade(t *testing.T) {
+	previous := http.DefaultClient
+	t.Cleanup(func() { http.DefaultClient = previous })
+	http.DefaultClient = &http.Client{Transport: helperReviewTransport(func(r *http.Request) (*http.Response, error) {
+		status, headers := http.StatusOK, make(http.Header)
+		if r.URL.Scheme == "https" {
+			status = http.StatusFound
+			headers.Set("Location", "http://example.invalid/")
+		}
+		return &http.Response{StatusCode: status, Header: headers, Body: io.NopCloser(strings.NewReader("")), Request: r}, nil
+	})}
+	request, _ := http.NewRequestWithContext(t.Context(), http.MethodGet, "https://example.invalid/", nil)
+	if response, err := fetch.Open(http.DefaultClient, request, 1); err == nil {
+		response.Body.Close()
+		t.Fatal("control: existing fetch policy unexpectedly accepted downgrade")
+	}
+	if (requestProbe{}).Answers(t.Context(), "https://example.invalid/") {
+		t.Fatal("HTTPS probe says yes although the successful response is plain HTTP; fetch.Open rejects the same redirect")
+	}
+}
