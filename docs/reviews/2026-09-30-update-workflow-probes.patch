@@ -0,0 +1,62 @@
+package engine
+
+import (
+	"github.com/herbygillot/dockhand/internal/macports"
+	"github.com/herbygillot/dockhand/internal/macports/portedit/archives"
+	"github.com/herbygillot/dockhand/internal/model"
+	"github.com/herbygillot/dockhand/internal/preparation"
+	"github.com/herbygillot/dockhand/internal/sourcecompare"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestUpdateReviewGitSourceHasNoComparison(t *testing.T) {
+	result := preparation.Result{}
+	result.Target = model.Target{Name: "demo"}
+	result.Prepared = macports.Snapshot{Ports: map[string]macports.PortInfo{"demo": {Name: "demo", Options: map[string]string{"fetch.type": "git"}}}}
+	comparison, _ := compareUpstream(t.Context(), result, sourcecompare.Versions{Old: "1", New: "2"})
+	require.Nil(t, comparison, "current git path records no comparison and contributes no hold")
+}
+
+func TestUpdateReviewUnknownPythonConstraintIsAdvisory(t *testing.T) {
+	f := setup(t)
+	e, _ := f.withPreparer(t)
+	e.PortReader = fakePorts{directories: map[string][]macports.PortInfo{"python/py-requests": {{Name: "py313-requests", Version: "not-a-version"}}}}
+	result := preparation.Result{}
+	result.Target = model.Target{Name: "demo"}
+	result.Prepared = macports.Snapshot{Ports: map[string]macports.PortInfo{"demo": port("demo", "py313-requests")}}
+	findings := e.pythonPins(t.Context(), model.Source{}, result, []pythonRequirement{{manifest: "pyproject.toml", Requirement: sourcecompare.Requirement{Name: "requests", Specifier: ">=999"}}})
+	require.Len(t, findings, 1)
+	require.False(t, findings[0].Hold, "current policy permits an unreadable dependency version")
+}
+
+func TestUpdateReviewUsesDoesNotProveUnused(t *testing.T) {
+	dir := t.TempDir()
+	old := archives.Download{Name: "old.tar.gz", Path: writeTarball(t, dir, "old", map[string]string{"package.json": `{"dependencies":{"left-pad":"^1"}}`})}
+	next := archives.Download{Name: "new.tar.gz", Path: writeTarball(t, dir, "new", map[string]string{"package.json": `{"dependencies":{"left-pad":"^1","new-runtime":"^1"}}`})}
+	result := preparation.Result{}
+	result.Target = model.Target{Name: "hybrid"}
+	result.Prepared = macports.Snapshot{Ports: map[string]macports.PortInfo{"hybrid": {Name: "hybrid", Options: map[string]string{"dockhand.portgroups": "cmake", "use_configure": "yes", "configure.cmd": "/opt/local/bin/cmake"}}}}
+	result.Downloads = []archives.Download{next}
+	result.Pairs = []preparation.ArchivePair{{Previous: old, Next: next}}
+	comparison, _ := compareUpstream(t.Context(), result, sourcecompare.Versions{})
+	require.False(t, comparison.Held(), "current heuristic suppresses Node findings when the PortGroup only identifies CMake")
+}
+
+func TestUpdateReviewAssessmentOutlivesItsEdit(t *testing.T) {
+	f := setup(t)
+	e, p := f.withPreparer(t)
+	branch, err := e.Start(t.Context(), StartRequest{Name: "review-history"})
+	require.NoError(t, err)
+	p.upstream = [2]map[string]string{{"LICENSE": "MIT\n"}, {"LICENSE": "GPL\n"}}
+	_, err = e.Update(t.Context(), UpdateRequest{Branch: branch, Action: model.EditUpdate, Port: "jq", Version: "2.0", CompareUpstream: true})
+	require.NoError(t, err)
+	p.upstream = [2]map[string]string{{"LICENSE": "GPL\n"}, {"LICENSE": "MIT\n"}}
+	_, err = e.Update(t.Context(), UpdateRequest{Branch: branch, Action: model.EditUpdate, Port: "jq", Version: "3.0", CompareUpstream: true})
+	require.NoError(t, err)
+	comparisons, err := e.upstreamComparisons(t.Context(), branch)
+	require.NoError(t, err)
+	require.Len(t, comparisons, 2, "current policy replays both historical transitions even though the final license matches the original")
+	require.True(t, comparisons[0].Comparison.Held())
+	require.True(t, comparisons[1].Comparison.Held())
+}
