+package sourcecompare
+
+import (
+	"github.com/herbygillot/dockhand/internal/testsupport"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestUpdateReviewPythonCompatibilitySurface(t *testing.T) {
+	old := testsupport.Tarball(t, "pkg-1", map[string]string{"pyproject.toml": "[project]\nrequires-python = \">=3.9\"\ndependencies = []\n[build-system]\nrequires = [\"setuptools>=61\"]\nbuild-backend = \"setuptools.build_meta\"\n"})
+	next := testsupport.Tarball(t, "pkg-2", map[string]string{"pyproject.toml": "[project]\nrequires-python = \">=3.13\"\ndependencies = []\n[build-system]\nrequires = [\"hatchling>=1\"]\nbuild-backend = \"hatchling.build\"\n"})
+	changes, err := Compare(t.Context(), old, next, Versions{Old: "1", New: "2"})
+	require.NoError(t, err)
+	require.Empty(t, changes, "current comparison omits Python support and build backend changes")
+}
+
+func TestUpdateReviewNestedProjectCoverage(t *testing.T) {
+	old := testsupport.Tarball(t, "pkg-1", map[string]string{"python/pyproject.toml": "[project]\ndependencies = [\"requests>=2\"]\n"})
+	next := testsupport.Tarball(t, "pkg-2", map[string]string{"python/pyproject.toml": "[project]\ndependencies = [\"requests>=2\", \"rich>=13\"]\n"})
+	changes, err := Compare(t.Context(), old, next, Versions{})
+	require.NoError(t, err)
+	require.Empty(t, changes, "current comparison does not name the nested project or its coverage gap")
+}
+
+func TestUpdateReviewFlatArchiveCoverage(t *testing.T) {
+	old := testsupport.Tarball(t, ".", map[string]string{"LICENSE": "MIT\n"})
+	next := testsupport.Tarball(t, ".", map[string]string{"LICENSE": "GPL\n"})
+	changes, err := Compare(t.Context(), old, next, Versions{})
+	require.NoError(t, err)
+	require.Empty(t, changes, "current comparison silently skips files in the archive root")
+}
+
+func TestUpdateReviewVersionOnlyNeedsSemanticContext(t *testing.T) {
+	old := testsupport.Tarball(t, "pkg-1.0", map[string]string{"CMakeLists.txt": "project(demo VERSION 1.0)\nfind_package(SomeLibrary 1.0 REQUIRED)\n"})
+	next := testsupport.Tarball(t, "pkg-2.0", map[string]string{"CMakeLists.txt": "project(demo VERSION 2.0)\nfind_package(SomeLibrary 2.0 REQUIRED)\n"})
+	changes, err := Compare(t.Context(), old, next, Versions{Old: "1.0", New: "2.0"})
+	require.NoError(t, err)
+	require.Len(t, changes, 1)
+	require.False(t, changes[0].Hold, "current version-only heuristic suppresses the dependency minimum change too")
+}
diff --git a/internal/engine/update_review_test.go b/internal/engine/update_review_test.go
