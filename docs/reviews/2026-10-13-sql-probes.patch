+func TestZZSteps(t *testing.T) {
+	dir := os.Getenv("STUDY_DIR")
+	if dir == "" {
+		t.Skip()
+	}
+	ctx := context.Background()
+	src := filepath.Join(dir, "syn.db")
+	proposed := os.Getenv("STUDY_PROPOSED") != ""
+	dst := filepath.Join(dir, "steps"+os.Getenv("STUDY_VARIANT")+".db")
+	for _, x := range []string{"", "-wal", "-shm"} {
+		os.Remove(dst + x)
+	}
+	data, _ := os.ReadFile(src)
+	os.WriteFile(dst, data, 0o600)
+	s, err := Open(ctx, dst, Options{OperationTimeout: 30 * time.Minute})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	repo := "repo_a"
+	at := int64(1 << 40)
+	ended := "SELECT id FROM branches WHERE repository_id=? AND state<>'open' AND ended_at IS NOT NULL AND ended_at<?"
+	endedRuns := "SELECT id FROM runs WHERE repository_id=? AND branch_id IN (" + ended + ")"
+	endedExecutions := "SELECT id FROM executions WHERE repository_id=? AND run_id IN (" + endedRuns + ")"
+	type step struct {
+		name, q string
+		args    []any
+	}
+	steps := []step{
+		{"results", "DELETE FROM results WHERE repository_id=? AND execution_id IN (" + endedExecutions + ") " +
+			"AND (execution_id, target_id) NOT IN (SELECT execution_id, target_id FROM (" + reusableBuilds + "))",
+			[]any{repo, repo, repo, repo, at, repo}},
+		{"executions", "DELETE FROM executions AS e WHERE e.repository_id=? AND e.run_id IN (" + endedRuns + ") " +
+			"AND NOT EXISTS (SELECT 1 FROM results r WHERE r.repository_id=e.repository_id AND (r.execution_id=e.id OR r.reused_from=e.id))",
+			[]any{repo, repo, repo, at}},
+		{"runs", "DELETE FROM runs AS u WHERE u.repository_id=? AND u.branch_id IN (" + ended + ") " +
+			"AND u.number<(SELECT max(v.number) FROM runs v WHERE v.repository_id=u.repository_id AND v.branch_id=u.branch_id) " +
+			"AND NOT EXISTS (SELECT 1 FROM executions e WHERE e.repository_id=u.repository_id AND e.run_id=u.id)",
+			[]any{repo, repo, at}},
+		{"plans", "DELETE FROM plans AS p WHERE p.repository_id=? AND p.revision_id IN (SELECT id FROM revisions WHERE repository_id=? AND branch_id IN (" + ended + ")) " +
+			"AND NOT EXISTS (SELECT 1 FROM runs u WHERE u.repository_id=p.repository_id AND u.plan_id=p.id)",
+			[]any{repo, repo, repo, at}},
+		{"revisions", "DELETE FROM revisions AS v WHERE v.repository_id=? AND v.branch_id IN (" + ended + ") " +
+			"AND NOT EXISTS (SELECT 1 FROM runs u WHERE u.repository_id=v.repository_id AND u.revision_id=v.id) " +
+			"AND NOT EXISTS (SELECT 1 FROM plans p WHERE p.repository_id=v.repository_id AND p.revision_id=v.id)",
+			[]any{repo, repo, at}},
+		{"inputs", "DELETE FROM inputs WHERE repository_id=? AND key NOT IN (SELECT inputs FROM results WHERE repository_id=? AND inputs<>'')",
+			[]any{repo, repo}},
+	}
+	if proposed {
+		steps[0] = step{"results", "WITH keep AS MATERIALIZED (" + reusableBuilds + ") DELETE FROM results WHERE repository_id=? AND execution_id IN (" + endedExecutions + ") " +
+			"AND NOT EXISTS (SELECT 1 FROM keep k WHERE k.execution_id=results.execution_id AND k.target_id=results.target_id)", []any{repo, repo, repo, repo, repo, at}}
+		steps[1] = step{"executions", "DELETE FROM executions AS e WHERE e.repository_id=? AND e.run_id IN (" + endedRuns + ") " +
+			"AND e.id NOT IN (SELECT execution_id FROM results WHERE repository_id=?) AND e.id NOT IN (SELECT reused_from FROM results WHERE repository_id=? AND reused_from<>'')", []any{repo, repo, repo, at, repo, repo}}
+		steps[3] = step{"plans", "DELETE FROM plans AS p WHERE p.repository_id=? AND p.revision_id IN (SELECT id FROM revisions WHERE repository_id=? AND branch_id IN (" + ended + ")) " +
+			"AND p.id NOT IN (SELECT plan_id FROM runs WHERE repository_id=?)", []any{repo, repo, repo, at, repo}}
+		steps[4] = step{"revisions", "DELETE FROM revisions AS v WHERE v.repository_id=? AND v.branch_id IN (" + ended + ") " +
+			"AND v.id NOT IN (SELECT revision_id FROM runs WHERE repository_id=?) AND v.id NOT IN (SELECT revision_id FROM plans WHERE repository_id=?)", []any{repo, repo, at, repo, repo}}
+	}
+	if v := os.Getenv("STUDY_VARIANT"); v == "B" || v == "C" {
+		for _, q := range []string{"CREATE INDEX run_plan ON runs(repository_id, plan_id)", "CREATE INDEX run_revision ON runs(repository_id, revision_id)", "CREATE INDEX plan_revision ON plans(repository_id, revision_id)", "CREATE INDEX result_reused ON results(repository_id, reused_from)"} {
+			if _, err := s.db.ExecContext(ctx, q); err != nil {
+				t.Fatal(err)
+			}
+		}
+		s.db.ExecContext(ctx, "ANALYZE")
+		steps[1] = step{"executions", "DELETE FROM executions AS e WHERE e.repository_id=? AND e.run_id IN (" + endedRuns + ") " +
+			"AND NOT EXISTS (SELECT 1 FROM results r WHERE r.repository_id=e.repository_id AND r.execution_id=e.id) AND NOT EXISTS (SELECT 1 FROM results r WHERE r.repository_id=e.repository_id AND r.reused_from=e.id)", []any{repo, repo, repo, at}}
+	}
+	total := time.Now()
+	for _, st := range steps {
+		start := time.Now()
+		res, err := s.db.ExecContext(ctx, st.q, st.args...)
+		var n int64
+		if err == nil {
+			n, _ = res.RowsAffected()
+		}
+		fmt.Printf("variant=%s proposed=%v %s: %v n=%d err=%v\n", os.Getenv("STUDY_VARIANT"), proposed, st.name, time.Since(start), n, err)
+	}
+	fmt.Printf("total %v\n", time.Since(total))
+}
