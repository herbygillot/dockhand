+func TestZZStudy(t *testing.T) {
+	dir := os.Getenv("STUDY_DIR")
+	if dir == "" {
+		t.Skip()
+	}
+	ctx := context.Background()
+	path := filepath.Join(dir, "syn.db")
+	fresh := false
+	if _, err := os.Stat(path); err != nil {
+		fresh = true
+	}
+	s, err := Open(ctx, path, Options{OperationTimeout: 10 * time.Minute})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	if fresh {
+		g := gen
+		if os.Getenv("STUDY_QUARTER") != "" {
+			g = strings.NewReplacer("i<5999", "i<1499", "i<17999", "i<4499", "i<199999", "i<49999", "i<19999", "i<4999", "i>5990", "i>1490", "i>40000", "i>10000", "i/11-3000", "i/11-750").Replace(g)
+		}
+		if _, err := s.db.ExecContext(ctx, g); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := s.db.ExecContext(ctx, "PRAGMA optimize=0x10002"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	repo := "repo_a"
+	env := []any{"tart", "darwin", "24", "arm64", "xcode"}
+	cat := func(a ...[]any) []any {
+		var out []any
+		for _, x := range a {
+			out = append(out, x...)
+		}
+		return out
+	}
+	r := func(a ...any) []any { return a }
+	runsStates, runsStatesArgs := runsQuery("repo_a", store.RunFilter{States: []model.RunState{"queued", "running"}})
+	runsBranch, runsBranchArgs := runsQuery("repo_a", store.RunFilter{Branch: "br_3"})
+	runsBranchLimit, runsBranchLimitArgs := runsQuery("repo_a", store.RunFilter{Branch: "br_3", Limit: 1})
+	runsLimit, runsLimitArgs := runsQuery("repo_a", store.RunFilter{Limit: 20})
+	aRev, aRevArgs := assessmentsQuery("repo_a", store.AssessmentFilter{Branch: "br_3", Tree: "tree_1", Base: "base"})
+	aBr, aBrArgs := assessmentsQuery("repo_a", store.AssessmentFilter{Branch: "br_3"})
+	ended := "SELECT id FROM branches WHERE repository_id=? AND state<>'open' AND ended_at IS NOT NULL AND ended_at<?"
+	endedRuns := "SELECT id FROM runs WHERE repository_id=? AND branch_id IN (" + ended + ")"
+	endedExecutions := "SELECT id FROM executions WHERE repository_id=? AND run_id IN (" + endedRuns + ")"
+	at := int64(1 << 40)
+	probes := []probe{
+		{"tx preamble repo", "SELECT 1 FROM repositories WHERE id=?", r(repo), false},
+		{"Branch", "SELECT " + branchColumns + " FROM branches WHERE repository_id=? AND id=?", r(repo, "br_3"), false},
+		{"BranchNamed", "SELECT " + branchColumns + " FROM branches WHERE repository_id=? AND name=? AND state<>'merged'", r(repo, "b3"), false},
+		{"MergedBranchNamed", "SELECT " + branchColumns + " FROM branches WHERE repository_id=? AND name=? AND state='merged' ORDER BY created_at DESC, id DESC LIMIT 1", r(repo, "b4"), false},
+		{"Branches(open)", "SELECT " + branchColumns + " FROM branches WHERE repository_id=? AND state IN (?) ORDER BY created_at, id", r(repo, "open"), false},
+		{"Revisions", revisionsQuery, r(repo, "br_3"), false},
+		{"NextSnapshot", "SELECT coalesce(max(snapshot), 0) FROM revisions WHERE repository_id=? AND branch_id=? AND kind='snapshot'", r(repo, "br_3"), false},
+		{"Runs(states)", runsStates, runsStatesArgs, false},
+		{"Runs(branch)", runsBranch, runsBranchArgs, false},
+		{"Runs(branch,limit1)", runsBranchLimit, runsBranchLimitArgs, false},
+		{"Runs(limit20)", runsLimit, runsLimitArgs, false},
+		{"NextRunNumber", "SELECT coalesce(max(number), 0) FROM runs WHERE repository_id=?", r(repo), false},
+		{"Executions(run)", "SELECT " + executionColumns + " FROM executions WHERE repository_id=? AND run_id=? ORDER BY created_at, rowid", r(repo, "run_100"), false},
+		{"ExecutionsReferred", referredQuery, r(repo, "tart-clone-5"), false},
+		{"Results(execution)", "SELECT " + resultColumns + " FROM results r WHERE r.repository_id=? AND r.execution_id=? ORDER BY r.recorded_at, r.rowid", r(repo, "ex_100"), false},
+		{"Reusable", reusableQuery, cat(r(repo, "port-42"), env, r(5)), false},
+		{"RecordResult run+plan", "SELECT u.id, u.plan_id FROM executions e JOIN runs u ON u.repository_id=e.repository_id AND u.id=e.run_id WHERE e.repository_id=? AND e.id=?", r(repo, "ex_5"), false},
+		{"RecordResult existing", "SELECT outcome FROM results WHERE repository_id=? AND execution_id=? AND target_id=?", r(repo, "ex_5", "port-1"), false},
+		{"reusableBuilds (window)", reusableBuilds, r(repo), false},
+		{"openBranchArchives (window)", openBranchArchives, r(repo), false},
+		{"PruneArchives (as SELECT)", "SELECT count(*) FROM archives AS a WHERE " + unnamedArchive, r(repo, at, repo, repo), false},
+		{"DependencyArchives", "SELECT digest, name, size, archive_kept, port, kept_at FROM (SELECT d.digest, a.name, a.size, a.kept_at AS archive_kept, d.port, d.kept_at, " +
+			"ROW_NUMBER() OVER (PARTITION BY d.port ORDER BY d.kept_at DESC, d.digest) AS newest FROM dependency_archives d JOIN archives a ON a.repository_id=d.repository_id AND a.digest=d.digest " +
+			"WHERE d.repository_id=? AND d.provider=? AND d.platform_os=? AND d.platform_version=? AND d.platform_architecture=? AND d.developer_tools=? AND d.port IN (?,?,?)) " +
+			"WHERE newest<=? ORDER BY port, kept_at DESC, digest", cat(r(repo), env, r("dep-1", "dep-2", "dep-3", 2)), false},
+		{"Archives()", "SELECT digest, name, size, kept_at FROM archives WHERE repository_id=? ORDER BY digest", r(repo), false},
+		{"PruneHistory results", "SELECT count(*) FROM results WHERE repository_id=? AND execution_id IN (" + endedExecutions + ") " +
+			"AND (execution_id, target_id) NOT IN (SELECT execution_id, target_id FROM (" + reusableBuilds + "))", r(repo, repo, repo, repo, at, repo), false},
+		{"PruneHistory executions", "SELECT count(*) FROM executions AS e WHERE e.repository_id=? AND e.run_id IN (" + endedRuns + ") " +
+			"AND NOT EXISTS (SELECT 1 FROM results r WHERE r.repository_id=e.repository_id AND (r.execution_id=e.id OR r.reused_from=e.id))", r(repo, repo, repo, at), false},
+		{"PruneHistory runs", "SELECT count(*) FROM runs AS u WHERE u.repository_id=? AND u.branch_id IN (" + ended + ") " +
+			"AND u.number<(SELECT max(v.number) FROM runs v WHERE v.repository_id=u.repository_id AND v.branch_id=u.branch_id) " +
+			"AND NOT EXISTS (SELECT 1 FROM executions e WHERE e.repository_id=u.repository_id AND e.run_id=u.id)", r(repo, repo, at), false},
+		{"PruneHistory plans", "SELECT count(*) FROM plans AS p WHERE p.repository_id=? AND p.revision_id IN (SELECT id FROM revisions WHERE repository_id=? AND branch_id IN (" + ended + ")) " +
+			"AND NOT EXISTS (SELECT 1 FROM runs u WHERE u.repository_id=p.repository_id AND u.plan_id=p.id)", r(repo, repo, repo, at), false},
+		{"PruneHistory revisions", "SELECT count(*) FROM revisions AS v WHERE v.repository_id=? AND v.branch_id IN (" + ended + ") " +
+			"AND NOT EXISTS (SELECT 1 FROM runs u WHERE u.repository_id=v.repository_id AND u.revision_id=v.id) " +
+			"AND NOT EXISTS (SELECT 1 FROM plans p WHERE p.repository_id=v.repository_id AND p.revision_id=v.id)", r(repo, repo, at), false},
+		{"PruneHistory inputs", "SELECT count(*) FROM inputs WHERE repository_id=? AND key NOT IN (SELECT inputs FROM results WHERE repository_id=? AND inputs<>'')", r(repo, repo), false},
+		{"PruneAssessments", "SELECT count(*) FROM assessments AS a WHERE a.repository_id=? AND a.branch_id IN (SELECT id FROM branches WHERE repository_id=? AND state='open') " +
+			"AND EXISTS (SELECT 1 FROM revisions v WHERE v.repository_id=a.repository_id AND v.branch_id=a.branch_id AND v.created_at<? AND v.tree_id<>a.tree " +
+			"AND v.created_at=(SELECT max(w.created_at) FROM revisions w WHERE w.repository_id=v.repository_id AND w.branch_id=v.branch_id))", r(repo, repo, at), false},
+		{"PruneJournal events", "SELECT count(*) FROM events WHERE repository_id=? AND at<?", r(repo, int64(50000)), false},
+		{"PruneJournal sessions", "SELECT count(*) FROM sessions WHERE repository_id=? AND COALESCE(ended_at, heartbeat_at)<? AND id NOT IN (SELECT holder FROM leases WHERE repository_id=? AND holder IS NOT NULL)", r(repo, at, repo), false},
+		{"CountEvents", countEventsQuery, r(repo, "serve.submit", int64(50000)), false},
+		{"Events", "SELECT sequence, at, session_id, branch_id, run_id, target_id, kind, level, message FROM events WHERE repository_id=? AND sequence>? ORDER BY sequence LIMIT ?", r(repo, int64(99000), 1000), false},
+		{"RunEvents", "SELECT sequence, at, session_id, branch_id, run_id, target_id, kind, level, message FROM events WHERE repository_id=? AND run_id=? AND sequence>? ORDER BY sequence LIMIT ?", r(repo, "run_5500", int64(0), 1000), false},
+		{"LastEvent", "SELECT COALESCE(MAX(sequence), 0) FROM events WHERE repository_id=?", r(repo), false},
+		{"Edits", "SELECT id, branch_id, kind, port, directory, subject, files, at, upstream, release FROM edits WHERE repository_id=? AND branch_id=? ORDER BY at, rowid", r(repo, "br_3"), false},
+		{"Assessments(rev)", aRev, aRevArgs, false},
+		{"Assessments(branch)", aBr, aBrArgs, false},
+		{"ChangeRecords(rev)", "SELECT record, at FROM change_records WHERE repository_id=? AND branch_id=? AND tree=? AND base=? ORDER BY +at DESC, rowid DESC", r(repo, "br_3", "tree_1", "base"), false},
