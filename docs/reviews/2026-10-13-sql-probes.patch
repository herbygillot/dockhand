+// A year-scale synthetic database built through Open (real migrations and
+// pragmas), then every production query explained and timed.
+const gen = `
+PRAGMA foreign_keys=OFF;
+BEGIN;
+INSERT INTO repositories VALUES('repo_a','/src/ports/.git',0);
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<299)
+INSERT INTO branches(repository_id,id,name,base,worktree,managed,title,state,created_at,ended_at)
+SELECT 'repo_a','br_'||i,'b'||i,'base','/wt/'||i,1,'t',CASE WHEN i%3=0 THEN 'open' ELSE 'merged' END,i,CASE WHEN i%3=0 THEN NULL ELSE 5000 END FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<5999)
+INSERT INTO revisions SELECT 'repo_a','rev_'||i,'br_'||(i%300),'commit',0,'c'||i,'tree_'||(i/2),'base','h'||i,1000+i FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<5999)
+INSERT INTO plans SELECT 'repo_a','plan_'||i,'rev_'||i,'{}',1000+i FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<5999)
+INSERT INTO runs(repository_id,id,number,branch_id,revision_id,plan_id,origin,state,detail,created_at,finished_at)
+SELECT 'repo_a','run_'||i,i+1,'br_'||(i%300),'rev_'||i,'plan_'||i,'serve',CASE WHEN i>5990 THEN 'queued' ELSE 'passed' END,'',1000+i,CASE WHEN i>5990 THEN NULL ELSE 2000+i END FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<17999)
+INSERT INTO executions(repository_id,id,run_id,provider,platform_os,platform_version,platform_architecture,developer_tools,attempt,state,detail,provider_ref,observed,identity,created_at,finished_at)
+SELECT 'repo_a','ex_'||i,'run_'||(i/3),'tart','darwin',CAST(23+(i%3) AS TEXT),'arm64','xcode',1,'finished','','tart-clone-'||i,'','id',1000+i,2000+i FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<199999)
+INSERT OR IGNORE INTO results(repository_id,execution_id,target_id,outcome,phase,tests,log,inputs,recorded_at,detail,builders,archive,reused_from,steps)
+SELECT 'repo_a','ex_'||(i/11),'port-'||((i*7919)%2000),CASE WHEN i%10=0 THEN 'failed' ELSE 'passed' END,'','none','logs/'||i||'.log','in_'||i,1000+i,'','',CASE WHEN i%2=0 THEN 'sha256:'||(i/10*10) ELSE '' END,CASE WHEN i%5=0 AND i>40000 THEN 'ex_'||(i/11-3000) ELSE '' END,'' FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<199999)
+INSERT INTO inputs SELECT 'repo_a','in_'||i,'{"x":1}' FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<19999)
+INSERT INTO archives SELECT 'repo_a','sha256:'||(i*10),'a'||i||'.tbz2',1000000,1000+i*10 FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<4999)
+INSERT INTO dependency_archives SELECT 'repo_a','sha256:'||(i*10),'dep-'||(i%400),'tart','darwin',CAST(23+(i%3) AS TEXT),'arm64','xcode',1000+i FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<59)
+INSERT INTO sessions SELECT 'repo_a','ses_'||i,'serve',100+i,'x','v',i,i,CASE WHEN i<59 THEN i+1 END FROM n;
+INSERT INTO leases VALUES('repo_a','serve','ses_59',4,0);
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<99999)
+INSERT INTO events(repository_id,at,session_id,branch_id,run_id,target_id,kind,level,message)
+SELECT 'repo_a',1000+i,'ses_1','br_'||(i%300),'run_'||(5000+i/100),'',
+ CASE WHEN i%500=0 THEN 'serve.submit' WHEN i%3=0 THEN 'progress' ELSE 'target.result' END,
+ CASE WHEN i%4=0 THEN 'verbose' ELSE 'info' END,'a message of about sixty bytes that describes what happened ok' FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<17999)
+INSERT INTO assessments SELECT 'repo_a','br_'||(i%300),'tree_'||(i/6),'base','port-'||(i%2000),'d','{}',1,1000+i FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<17999)
+INSERT INTO change_records SELECT 'repo_a','br_'||(i%300),'tree_'||(i/6),'base','d'||(i%2000),'{}',1,1000+i FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<5999)
+INSERT INTO edits(repository_id,id,branch_id,kind,port,directory,subject,files,at) SELECT 'repo_a','ed_'||i,'br_'||(i%300),'update','p','d','s','[]',1000+i FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<1999)
+INSERT INTO checkpoints(repository_id,number,branch_id,before_head,after_head,at) SELECT 'repo_a',i+1,'br_'||(i%300),'a','b',1000+i FROM n;
+WITH RECURSIVE n(i) AS (SELECT 0 UNION ALL SELECT i+1 FROM n WHERE i<1999)
+INSERT INTO reviews SELECT 'repo_a','macports/macports-ports',30000+(i%500),'h','[]','',1000+i FROM n;
+COMMIT;
+`
+
+type probe struct {
+	name, query string
+	args        []any
+	write       bool
+}
