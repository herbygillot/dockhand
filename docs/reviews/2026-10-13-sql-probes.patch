+func TestZZOverhead(t *testing.T) {
+	dir := os.Getenv("STUDY_DIR")
+	if dir == "" {
+		t.Skip()
+	}
+	ctx := context.Background()
+	s, err := Open(ctx, filepath.Join(dir, "syn.db"), Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	n := 2000
+	start := time.Now()
+	for i := 0; i < n; i++ {
+		_ = s.View(ctx, "repo_a", func(r store.Reader) error { return nil })
+	}
+	fmt.Printf("empty View: %v each\n", time.Since(start)/time.Duration(n))
+	start = time.Now()
+	for i := 0; i < n; i++ {
+		_ = s.View(ctx, "repo_a", func(r store.Reader) error { _, err := r.Run("run_100"); return err })
+	}
+	fmt.Printf("View(Run): %v each\n", time.Since(start)/time.Duration(n))
+	start = time.Now()
+	for i := 0; i < n; i++ {
+		_ = s.View(ctx, "repo_a", func(r store.Reader) error {
+			for j := 0; j < 10; j++ {
+				if _, err := r.Run("run_100"); err != nil {
+					return err
+				}
+			}
+			return nil
+		})
+	}
+	fmt.Printf("View(10xRun): %v each\n", time.Since(start)/time.Duration(n))
+	start = time.Now()
+	for i := 0; i < n; i++ {
+		_ = s.View(ctx, "repo_a", func(r store.Reader) error { _, err := r.Plan("plan_100"); return err })
+	}
+	fmt.Printf("View(Plan tiny): %v each\n", time.Since(start)/time.Duration(n))
+	start = time.Now()
+	for i := 0; i < 200; i++ {
+		_ = s.Update(ctx, "repo_a", func(tx store.Tx) error { return tx.CheckLease(model.Lease{Resource: "serve", Holder: "ses_59", Generation: 4}) })
+	}
+	fmt.Printf("no-op Update: %v each\n", time.Since(start)/200)
+	start = time.Now()
+	for i := 0; i < 200; i++ {
+		_ = s.Update(ctx, "repo_a", func(tx store.Tx) error {
+			_, err := tx.AppendEvent(model.Event{Kind: "progress", At: time.Now(), Message: "x"})
+			return err
+		})
+	}
+	fmt.Printf("1-event Update (linux fsync): %v each\n", time.Since(start)/200)
+}
