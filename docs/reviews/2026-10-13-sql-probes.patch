+		{"LastReview", "SELECT head, findings, posted, at FROM reviews WHERE repository_id=? AND pr_repository=? AND number=? ORDER BY at DESC, rowid DESC LIMIT 1", r(repo, "macports/macports-ports", 30001), false},
+		{"ALT results keep-CTE", "WITH keep AS MATERIALIZED (" + reusableBuilds + ") SELECT count(*) FROM results WHERE repository_id=? AND execution_id IN (" + endedExecutions + ") " +
+			"AND NOT EXISTS (SELECT 1 FROM keep k WHERE k.execution_id=results.execution_id AND k.target_id=results.target_id)", r(repo, repo, repo, repo, repo, at), false},
+		{"ALT executions NOT IN", "SELECT count(*) FROM executions AS e WHERE e.repository_id=? AND e.run_id IN (" + endedRuns + ") " +
+			"AND e.id NOT IN (SELECT execution_id FROM results WHERE repository_id=?) AND e.id NOT IN (SELECT reused_from FROM results WHERE repository_id=? AND reused_from<>'')", r(repo, repo, repo, at, repo, repo), false},
+		{"ALT executions 2xNOT EXISTS", "SELECT count(*) FROM executions AS e WHERE e.repository_id=? AND e.run_id IN (" + endedRuns + ") " +
+			"AND NOT EXISTS (SELECT 1 FROM results r WHERE r.repository_id=e.repository_id AND r.execution_id=e.id) AND NOT EXISTS (SELECT 1 FROM results r WHERE r.repository_id=e.repository_id AND r.reused_from=e.id)", r(repo, repo, repo, at), false},
+		{"ALT plans NOT IN", "SELECT count(*) FROM plans AS p WHERE p.repository_id=? AND p.revision_id IN (SELECT id FROM revisions WHERE repository_id=? AND branch_id IN (" + ended + ")) " +
+			"AND p.id NOT IN (SELECT plan_id FROM runs WHERE repository_id=?)", r(repo, repo, repo, at, repo), false},
+		{"ALT revisions NOT IN", "SELECT count(*) FROM revisions AS v WHERE v.repository_id=? AND v.branch_id IN (" + ended + ") " +
+			"AND v.id NOT IN (SELECT revision_id FROM runs WHERE repository_id=?) AND v.id NOT IN (SELECT revision_id FROM plans WHERE repository_id=?)", r(repo, repo, at, repo, repo), false},
+		{"ALT reusableBuilds+index", reusableBuilds, r(repo), false},
+		{"Lease", "SELECT holder, generation, acquired_at FROM leases WHERE repository_id=? AND resource=?", r(repo, "serve"), false},
+		{"Session", "SELECT " + sessionColumns + " FROM sessions WHERE repository_id=? AND id=?", r(repo, "ses_3"), false},
+	}
+	only := os.Getenv("STUDY_ONLY")
+	for _, p := range probes {
+		if only != "" && !strings.Contains(p.name, only) {
+			continue
+		}
+		rows, err := s.db.QueryContext(ctx, "EXPLAIN QUERY PLAN "+p.query, p.args...)
+		if err != nil {
+			t.Fatalf("%s: %v", p.name, err)
+		}
+		var plan []string
+		for rows.Next() {
+			var id, parent, notused int
+			var detail string
+			rows.Scan(&id, &parent, &notused, &detail)
+			plan = append(plan, fmt.Sprintf("%d<%d %s", id, parent, detail))
+		}
+		rows.Close()
+		qctx, cancel := context.WithTimeout(ctx, 60*time.Second)
+		start := time.Now()
+		n := 0
+		rows, err = s.db.QueryContext(qctx, p.query, p.args...)
+		if err == nil {
+			for rows.Next() {
+				n++
+			}
+			err = rows.Err()
+			rows.Close()
+		}
+		cancel()
+		el := time.Since(start)
+		fmt.Printf("=== %s: %v rows=%d err=%v\n", p.name, el, n, err)
+		for _, l := range plan {
+			fmt.Println("    " + l)
+		}
+	}
+}
