+func TestZZPrune(t *testing.T) {
+	dir := os.Getenv("STUDY_DIR")
+	if dir == "" {
+		t.Skip()
+	}
+	ctx := context.Background()
+	src := filepath.Join(dir, "syn.db")
+	dst := filepath.Join(dir, "prune.db")
+	os.Remove(dst)
+	os.Remove(dst + "-wal")
+	os.Remove(dst + "-shm")
+	data, _ := os.ReadFile(src)
+	os.WriteFile(dst, data, 0o600)
+	timeout := 30 * time.Second
+	if os.Getenv("STUDY_LONG") != "" {
+		timeout = 20 * time.Minute
+	}
+	s, err := Open(ctx, dst, Options{OperationTimeout: timeout})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	start := time.Now()
+	var pruned store.Pruned
+	err = s.Update(ctx, "repo_a", func(tx store.Tx) error {
+		var err error
+		pruned, err = tx.PruneHistory(time.UnixMilli(1 << 40))
+		return err
+	})
+	fmt.Printf("PruneHistory: %v err=%v pruned=%+v\n", time.Since(start), err, pruned)
+	start = time.Now()
+	var archives []model.Archive
+	err = s.Update(ctx, "repo_a", func(tx store.Tx) error {
+		var err error
+		archives, err = tx.PruneArchives(time.UnixMilli(1 << 40))
+		return err
+	})
+	fmt.Printf("PruneArchives: %v err=%v n=%d\n", time.Since(start), err, len(archives))
+}
