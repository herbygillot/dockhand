+package assess
+
+import (
+	"testing"
+
+	"github.com/herbygillot/dockhand/internal/macports"
+	"github.com/herbygillot/dockhand/internal/project"
+	"github.com/stretchr/testify/require"
+)
+
+func TestReviewDifferentArchivesShareAFindingIdentity(t *testing.T) {
+	read := func(license string) project.Reading {
+		return project.Reading{Layout: project.Enclosed, Files: map[string]project.File{"LICENSE": {Data: []byte(license)}}}
+	}
+	result := Assess(Input{Port: macports.PortInfo{Name: "demo"}, Pairs: []Pair{
+		{Archive: "main.tar.gz", Before: read("MIT\n"), After: read("GPL\n")},
+		{Archive: "support.tar.gz", Before: read("BSD\n"), After: read("Apache\n")},
+	}})
+	require.Len(t, result.Changes, 1, "current behavior: two distinct archive LICENSE changes collapse")
+	require.Len(t, result.Coverage, 1, "coverage also has no archive identity")
+	t.Log("two archives with separate LICENSE changes produce one finding and one coverage entry")
+}
