+package sourcecompare
+
+import (
+	"testing"
+
+	"github.com/herbygillot/dockhand/internal/project"
+	"github.com/stretchr/testify/require"
+)
+
+func TestReviewCMakeMultilineConditionLosesItsLocation(t *testing.T) {
+	read := func(text string) project.Reading {
+		return project.Reading{Layout: project.Enclosed, Files: map[string]project.File{"CMakeLists.txt": {Data: []byte(text)}}}
+	}
+	before := "option(DEMO \"demo\" OFF)\nif(\n  DEMO\n)\n  message(STATUS \"old\")\nendif()\n"
+	after := "option(DEMO \"demo\" OFF)\nif(\n  DEMO\n)\n  message(STATUS \"new\")\nendif()\n"
+	changes := Compare(read(before), read(after), Versions{}, nil)
+	require.Len(t, changes, 1)
+	require.Equal(t, "options", changes[0].How, "the project reader correctly recognizes the unreachable block")
+	require.Contains(t, changes[0].Message, "outside any if()", "current behavior: the separate line parser loses the multiline condition")
+	t.Log(changes[0].Message)
+}
