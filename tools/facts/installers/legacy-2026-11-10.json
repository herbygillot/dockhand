{
 "date": "2026-11-10",
 "source": "~/Downloads/xcode_archives (installers added 2026-11-10)",
 "method": "read-only: hdiutil -readonly; Xcode 4.3+ dmgs read straight off the mount; xip --expand for Xcode 8/9 xips; pkgutil --expand-full for CLT dmgs and the Xcode 3.2.6 mpkg packages; clang build and gcc versions read with byte regexes, no binary executed",
 "notes": [
  "ProductBuildVersion for SDKs comes from the SDK's System/Library/CoreServices/SystemVersion.plist; SDKSettings.plist has none in these SDKs",
  "gcc_cc1 holds GCC version strings read from cc1 (the gcc/llvm-gcc drivers carry none)",
  "CLT include_dirs lists payloads that install headers; has_stdio.h marks the libc headers",
  "per-installer files keep fuller detail (package ids, clang binary path, toolchain Info.plist)"
 ],
